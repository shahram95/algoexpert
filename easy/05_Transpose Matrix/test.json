{
  "tests": [
    {
      "matrix": [[1]],
      "expected": [[1]]
    },
    {
      "matrix": [[1], [-1]],
      "expected": [[1, -1]]
    },
    {
      "matrix": [[1, 2, 3]],
      "expected": [[1], [2], [3]]
    },
    {
      "matrix": [[1], [2], [3]],
      "expected": [[1, 2, 3]]
    },
    {
      "matrix": [[1, 2, 3], [4, 5, 6]],
      "expected": [[1, 4], [2, 5], [3, 6]]
    },
    {
      "matrix": [[0, 0, 0], [1, 1, 1]],
      "expected": [[0, 1], [0, 1], [0, 1]]
    },
    {
      "matrix": [[0, 1], [0, 1], [0, 1]],
      "expected": [[0, 0, 0], [1, 1, 1]]
    },
    {
      "matrix": [[0, 0, 0], [0, 0, 0]],
      "expected": [[0, 0], [0, 0], [0, 0]]
    },
    {
      "matrix": [[1, 4], [2, 5], [3, 6]],
      "expected": [[1, 2, 3], [4, 5, 6]]
    },
    {
      "matrix": [[-7, -7], [100, 12], [-33, 17]],
      "expected": [[-7, 100, -33], [-7, 12, 17]]
    },
    {
      "matrix": [[1, 2, 3], [4, 5, 6], [7, 8, 9]],
      "expected": [[1, 4, 7], [2, 5, 8], [3, 6, 9]]
    },
    {
      "matrix": [[1, 4, 7], [2, 5, 8], [3, 6, 9]],
      "expected": [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
    },
    {
      "matrix": [[5, 6, 3, -3, 12], [-3, 6, 5, 2, -1], [0, 0, 3, 12, 3]],
      "expected": [[5, -3, 0], [6, 6, 0], [3, 5, 3], [-3, 2, 12], [12, -1, 3]]
    },
    {
      "matrix": [[0, -1, -2, -3], [4, 5, 6, 7], [2, 3, -2, -3], [42, 100, 30, -42]],
      "expected": [[0, 4, 2, 42], [-1, 5, 3, 100], [-2, 6, -2, 30], [-3, 7, -3, -42]]
    },
    {
      "matrix": [[1234, 6935, 4205], [-23459, 314159, 0], [100, 3, 987654]],
      "expected": [[1234, -23459, 100], [6935, 314159, 3], [4205, 0, 987654]]
    }
  ]
}
